{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "validate",
    "type": "object",
    "definitions": {
        "log": {
            "type": "object",
            "properties": {
                "level": {
                    "description": "The level of the log.",
                    "oneOf": [
                        {
                            "type": "string",
                            "enum": [
                                "error",
                                "warning",
                                "info",
                                "recommendation"
                            ]
                        },
                        {
                            "type": "number"
                        }
                    ]
                },
                "error": {
                    "type": "string",
                    "description": "The error name. E.g. UNKJSON."
                },
                "id": {
                    "type": "number",
                    "description": "The id of the log."
                }
            },
            "additionalProperties": true
        }
    },
    "properties": {
        "suite": {
            "type": "string",
            "description": "The suite to run. 'default'/'main' run the in-development checks, 'addon' the add-on requirements, 'all' runs the default suite plus every derived suite (addon, sharing, currentplatform).",
            "default": "addon",
            "enum": [
                "all",
                "default",
                "main",
                "addon",
                "currentplatform",
                "sharing",
                "sharingstrict"
            ]
        },
        "exclusions": {
            "type": "array",
            "description": "Validator ids to exclude from the run, e.g. [\"PATHLENGTH\", \"PACKSIZE\"].",
            "default": [],
            "items": {
                "type": "string"
            }
        },
        "failOnError": {
            "type": "boolean",
            "description": "Fail the run if there are any errors.",
            "default": false
        },
        "annoyance": {
            "type": "string",
            "description": "Annoyance to show to make sure the user knows something went wrong.",
            "default": "none",
            "enum": [
                "alert",
                "none"
            ]
        },
        "logOverrides": {
            "type": "array",
            "description": "Overrides for log messages. Usually used to ignore certain errors.",
            "items": {
                "type": "object",
                "properties": {
                    "match": {
                        "$ref": "#/definitions/log",
                        "description": "The log to match.",
                        "required": [
                            "error"
                        ]
                    },
                    "override": {
                        "description": "The override.",
                        "$ref": "#/definitions/log"
                    }
                }
            }
        },
        "outputFolder": {
            "type": "string",
            "description": "Folder (relative to the pack root) where the HTML/CSV/JSON reports are written. Set to an empty string to skip report generation.",
            "default": "./mct-output/"
        }
    }
}
